generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppRole {
  ADMIN
  INSTRUCTOR
  STUDENT
  @@map("app_role")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  @@map("course_status")
}

model User {
  id        String   @id @db.Uuid
  email     String?
  fullName  String   @default("") @map("full_name")
  role      AppRole  @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  isActive Boolean @default(true) @map("is_active")
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)
  departmentId String? @map("department_id") @db.Uuid
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses   Course[] @relation("CourseInstructor")
  feedback  Feedback[] @relation("FeedbackCreator")
  responses Response[]
  courseEnrollments CourseEnrollment[] @relation("CourseEnrollmentStudent")
  enrollmentsCreated CourseEnrollment[] @relation("CourseEnrollmentActor")
  instructorAssignments InstructorCourseAssignment[] @relation("InstructorAssignmentInstructor")
  assignmentsCreated InstructorCourseAssignment[] @relation("InstructorAssignmentActor")
  auditLogs AuditLog[] @relation("AuditActor")
  @@index([departmentId])
  @@map("users")
}

model Course {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  title        String
  description  String       @default("")
  status       CourseStatus @default(DRAFT)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  departmentId String?      @map("department_id") @db.Uuid
  semesterId   String?      @map("semester_id") @db.Uuid
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  semester     Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  instructor   User         @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  feedback     Feedback[]
  enrollments CourseEnrollment[]
  instructorAssignments InstructorCourseAssignment[]
  @@index([departmentId])
  @@index([semesterId])
  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Feedback {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId     String     @map("course_id") @db.Uuid
  createdBy    String     @map("created_by") @db.Uuid
  title        String
  description  String     @default("")
  formSchema   Json       @map("form_schema")
  isOpen       Boolean    @default(true) @map("is_open")
  retentionDays Int       @default(365) @map("retention_days")
  dueAt        DateTime?  @map("due_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator      User       @relation("FeedbackCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  responses    Response[]
  anonymousSubmissions AnonymousSubmission[]
  @@index([courseId])
  @@map("feedback")
}

model Response {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId  String   @map("feedback_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  answers     Json
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([feedbackId, studentId])
  @@index([feedbackId])
  @@index([studentId])
  @@index([submittedAt])
  @@map("responses")
}

model AnonymousSubmission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  answers    Json
  receivedOn DateTime @default(dbgenerated("CURRENT_DATE")) @map("received_on") @db.Date
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@index([feedbackId])
  @@index([receivedOn])
  @@map("anonymous_submissions")
}

model Department {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  code String @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users User[]
  courses Course[]
  @@map("departments")
}

model Semester {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  isActive Boolean @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courses Course[]
  @@map("semesters")
}

model CourseEnrollment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  enrolledBy String @map("enrolled_by") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User @relation("CourseEnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  actor User @relation("CourseEnrollmentActor", fields: [enrolledBy], references: [id], onDelete: Restrict)
  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model InstructorCourseAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  instructorId String @map("instructor_id") @db.Uuid
  assignedBy String @map("assigned_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User @relation("InstructorAssignmentInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  actor User @relation("InstructorAssignmentActor", fields: [assignedBy], references: [id], onDelete: Restrict)
  @@unique([courseId, instructorId])
  @@index([instructorId])
  @@map("instructor_course_assignments")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  targetType String @map("target_type")
  targetId String? @map("target_id") @db.Uuid
  details Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
